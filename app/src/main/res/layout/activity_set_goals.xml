<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            android:layout_centerVertical="true"
            app:tint="@color/gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/financial_goals"
            style="@style/TextAppearance.CoinQuest.Headline"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/min_income_goal"
        style="@style/TextAppearance.CoinQuest.Title"
        android:textSize="@dimen/text_size_body"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etMinIncome"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="@string/hint_min_income"
        android:inputType="numberDecimal"
        android:textColor="@color/white"
        android:textColorHint="#888888"
        android:backgroundTint="@color/gold"
        android:layout_marginBottom="24dp"
        android:autofillHints="none"
        android:paddingHorizontal="12dp"
        android:textSize="@dimen/text_size_body"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/max_expense_goal"
        style="@style/TextAppearance.CoinQuest.Title"
        android:textSize="@dimen/text_size_body"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etMaxExpense"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="@string/hint_max_expense"
        android:inputType="numberDecimal"
        android:textColor="@color/white"
        android:textColorHint="#888888"
        android:backgroundTint="@color/gold"
        android:layout_marginBottom="32dp"
        android:autofillHints="none"
        android:paddingHorizontal="12dp"
        android:textSize="@dimen/text_size_body"/>

    <Button
        android:id="@+id/btnSaveGoals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_goals"/>

</LinearLayout>
