<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CoinQuest" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:windowBackground">@drawable/bg_main_gradient</item>

        <!-- Default Text Appearances -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.CoinQuest.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.CoinQuest.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.CoinQuest.Body</item>

        <!-- Button Styles -->
        <item name="materialButtonStyle">@style/Widget.CoinQuest.Button</item>
    </style>

    <!-- Custom Button Styles -->
    <style name="Widget.CoinQuest.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CoinQuest.Button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="ShapeAppearance.CoinQuest.Button" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Headline Style: Consistent Bold Gold Titles -->
    <style name="TextAppearance.CoinQuest.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gold</item>
    </style>

    <!-- Title Style: Consistent Semi-Bold White/Gold Subtitles -->
    <style name="TextAppearance.CoinQuest.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Body Style: Consistent Normal White Text -->
    <style name="TextAppearance.CoinQuest.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Theme.CoinQuest" parent="Base.Theme.CoinQuest" />
</resources>